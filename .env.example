VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — serve over HTTPS on your LAN so phones can install the PWA.
# Point these at a cert/key issued by your own CA (see docs/SETUP.md §LAN HTTPS).
# When both are set, dev/preview also bind to the LAN (host: true).
#DEV_TLS_CERT=/absolute/path/to/dev-cert.pem
#DEV_TLS_KEY=/absolute/path/to/dev-key.pem
